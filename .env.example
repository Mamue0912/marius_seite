# =========================================================
#  Cockpit – Outlook Live Sync · Umgebungsvariablen
#  Kopiere nach .env.local (lokal) bzw. trage die Werte in
#  Vercel → Project → Settings → Environment Variables ein.
#  NIEMALS echte Secrets committen.
# =========================================================

# Öffentliche Basis-URL der App (ohne abschließenden Slash)
# Lokal: dein Tunnel (z. B. https://xyz.trycloudflare.com), Prod: https://cockpit.deine-domain.de
APP_BASE_URL=

# Microsoft Entra / Azure App-Registrierung
# MS_TENANT=common erlaubt private (outlook.com/hotmail/live) UND Arbeits-/Schulkonten
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT=common
MS_REDIRECT_PATH=/api/auth/microsoft/callback

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Verschlüsselung der gespeicherten Microsoft-Tokens (32 Byte base64: openssl rand -base64 32)
TOKEN_ENC_KEY=

# Signatur/Secrets (je: openssl rand -hex 32)
OAUTH_STATE_SECRET=
CRON_SECRET=
GRAPH_CLIENT_STATE=

# Sicherheitsnetz: Minuten ohne Webhook, ab denen eine Delta-Kontrolle erzwungen wird
FALLBACK_DELTA_MINUTES=5

# --- E-Mail-Antwort-Assistent (Claude) ---
# API-Schlüssel liegt NUR serverseitig. Nie im Frontend.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# Versand: standardmäßig AUS. Auf true setzen, um Mail.Send anzufordern und den
# "Senden"-Knopf zu aktivieren. Nur dann wird die Sendeberechtigung genutzt.
ENABLE_SEND=false
